import {
  "huahai29/moonwitness" @witness,
}

pkgtype(kind: "executable")

options(
  supported_targets: "js",
  link: {
    "js": {
      "exports": [
        "analyze",
        "analyze_baseline",
        "capture_new",
        "capture_begin",
        "capture_finish",
        "capture_fail",
        "capture_history",
        "presentation",
        "probe_input",
        "probe_output",
      ],
      "format": "esm",
    },
  },
)
